# The runner itself (runner/runner.py): talks to the hub and starts the agent containers through the
# Docker socket. Build context is the repo root (see compose.yml). Only the Docker CLI is copied from
# the official image "docker:cli": no daemon, no extra packages.
FROM python:3.13-slim
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
# Compose (27.11.2026): runner/hubctl.py stops and starts the hub's services while it puts a backup back or changes .env.
COPY --from=docker:cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
# Proven encryption for the saved Claude tokens (runner/tokens.py); age for the backups (runner/hubctl.py, 27.11.2026:
# the same pinned version as the web service, which makes the recovery key; it encrypts files in a stream).
RUN pip install --no-cache-dir cryptography==50.0.2 pyrage==1.3.0
# git: the projects' code and the tasks' folders (runner/workspace.py), 15.11.2026.
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY runner/ /app/runner/
CMD ["python", "-u", "-m", "runner.runner"]
