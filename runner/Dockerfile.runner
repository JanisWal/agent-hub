# The runner itself (runner/runner.py): talks to the hub and starts the agent containers through the
# Docker socket. Build context is the repo root (see compose.yml). Only the Docker CLI is copied from
# the official image "docker:cli": no daemon, no extra packages.
FROM python:3.13-slim
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
# The one package beyond the standard library: proven encryption for the saved Claude tokens (runner/tokens.py).
RUN pip install --no-cache-dir cryptography==50.0.2
WORKDIR /app
COPY runner/ /app/runner/
CMD ["python", "-u", "-m", "runner.runner"]
