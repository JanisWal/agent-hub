# Image of a Mistral run (Mistral Vibe, the coding agent of Mistral; started by launcher.build_vibe_command as user
# 10000+id, read-only, like the Claude image). Vibe never sees the user's API key: it gets a ticket and talks to the
# egress gateway (runner/egress.py, port 3131). vibe_entry.py writes Vibe's settings into the run's memory folder.
# poppler-utils (pdftotext, pdftoppm, pdfinfo): hub_tools.py shows PDFs as text and page pictures (18.11.2026).
FROM python:3.13-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ripgrep ca-certificates curl poppler-utils \
 && rm -rf /var/lib/apt/lists/*
# Pinned: a new Vibe version is tried on a branch first (its settings and output format may change).
RUN pip install --no-cache-dir --root-user-action=ignore mistral-vibe==3.1.2
RUN apt-get update \
 && apt-get install -y --no-install-recommends "nodejs=20.19.*" "npm=9.2.0*" \
 && rm -rf /var/lib/apt/lists/*
# The agents' test browser (hub_browser.js, 21.11.2026): Chromium from Debian, driven by playwright-core (fixed).
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g playwright-core@1.52.0 \
 && npm cache clean --force
ENV NODE_PATH=/usr/local/lib/node_modules
COPY hub_browser.js /opt/hub/
RUN chmod 755 /opt/hub/hub_browser.js && ln -s /opt/hub/hub_browser.js /usr/local/bin/hub-browser
COPY vibe_entry.py hub_tools.py /opt/hub/
WORKDIR /work
